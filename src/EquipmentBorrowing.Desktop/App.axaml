<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EquipmentBorrowing.Desktop.App"
             xmlns:local="using:EquipmentBorrowing.Desktop"
             RequestedThemeVariant="Light">

	<Application.DataTemplates>
		<local:ViewLocator />
	</Application.DataTemplates>

	<Application.Styles>
		<FluentTheme />

		<!-- Shared Heading Style -->
		<Style Selector="TextBlock.heading">
			<Setter Property="FontSize" Value="24"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#0F172A"/>
		</Style>

		<Style Selector="TextBlock.subheading">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="#64748B"/>
		</Style>

		<Style Selector="TextBlock.sectionTitle">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="#64748B"/>
			<Setter Property="LetterSpacing" Value="0.5"/>
		</Style>

		<!-- Primary Action Button (Borrow) -->
		<Style Selector="Button.primaryBtn">
			<Setter Property="Background" Value="#2563EB"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="16,10"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#1D4ED8"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<!-- Warning Action Button (Return) -->
		<Style Selector="Button.warningBtn">
			<Setter Property="Background" Value="#D97706"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="16,10"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.warningBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#B45309"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<!-- Sidebar Navigation Button -->
		<Style Selector="Button.navBtn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#334155"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="14,10"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.navBtn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#E2E8F0"/>
			<Setter Property="Foreground" Value="#0F172A"/>
		</Style>

		<!-- Card Container Border Style -->
		<Style Selector="Border.card">
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#E2E8F0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="16"/>
		</Style>
	</Application.Styles>
</Application>