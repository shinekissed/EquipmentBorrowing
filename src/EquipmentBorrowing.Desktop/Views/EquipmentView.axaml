<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="16">
        <!-- Page Title -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Equipment Catalog &amp; Borrowing" FontSize="24" FontWeight="Bold" Foreground="#1E293B" />
            <TextBlock Text="Select an item, assign a student, and initiate borrowing transactions." Foreground="#64748B" />
        </StackPanel>

        <!-- Main Content Grid -->
        <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="16">

            <!-- Equipment List Area -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#E2E8F0" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" 
                               Text="EQUIPMENT INVENTORY" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               Foreground="#64748B" 
                               Margin="4,0,0,10"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding EquipmentList}"
                             SelectedItem="{Binding SelectedEquipment}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Equipment">
                                <Border Padding="12,10" Margin="0,3" CornerRadius="6" Background="#F8FAFC">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- ID Badge -->
                                        <Border Grid.Column="0" Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                        </Border>

                                        <!-- Equipment Name -->
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" FontSize="14" VerticalAlignment="Center"/>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="2" 
                                                Background="#EEF2F6" 
                                                CornerRadius="4" 
                                                Padding="8,3" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IsAvailable, StringFormat='Available: {0}'}" 
                                                       FontSize="11" 
                                                       FontWeight="Bold"
                                                       Foreground="#2563EB"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Borrowing Action Form -->
            <Border Grid.Column="1" 
                    Background="#F8FAFC" 
                    BorderBrush="#CBD5E1" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="18">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock Text="BORROW EQUIPMENT FORM" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>

                        <!-- Selected Item Info -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Selected Item:" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedEquipment.Name, FallbackValue='(None selected)'}" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="#0F172A" />
                        </StackPanel>

                        <Separator Background="#E2E8F0"/>

                        <!-- Student Selector -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Select Borrower (Student):" FontSize="13" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding Students}"
                                      SelectedItem="{Binding SelectedStudent}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="domain:Student">
                                        <TextBlock Text="{Binding Name, StringFormat='{}#{0} — {0}'}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Expected Return Date -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Expected Return Date:" FontSize="13" FontWeight="SemiBold"/>
                            <DatePicker SelectedDate="{Binding ExpectedReturnDate}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Submit Button -->
                        <Button Content="Borrow Equipment"
                                Command="{Binding BorrowEquipmentCommand}"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="0,12"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0,8,0,0"/>

                        <!-- Feedback & Validation Banner -->
                        <Border IsVisible="{Binding HasFeedback}"
                                Background="#F1F5F9"
                                BorderBrush="#94A3B8"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,10,0,0">
                            <TextBlock Text="{Binding FeedbackMessage}"
                                       Foreground="#0F172A"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>

</UserControl>