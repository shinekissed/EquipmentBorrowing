<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="16">
        <!-- Page Title -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Equipment Catalog" FontSize="24" FontWeight="Bold" Foreground="#1E293B" />
            <TextBlock Text="Browse available laboratory equipment and view availability." Foreground="#64748B" />
        </StackPanel>

        <!-- Main Area: Left List (3*) and Right Details Panel (2*) -->
        <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="16">
            
            <!-- Equipment List -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#E2E8F0" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" 
                               Text="EQUIPMENT INVENTORY" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               Foreground="#64748B" 
                               Margin="4,0,0,10"/>
                    
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding EquipmentList}"
                             SelectedItem="{Binding SelectedEquipment}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Equipment">
                                <Border Padding="12,10" Margin="0,3" CornerRadius="6" Background="#F8FAFC">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- ID Badge -->
                                        <Border Grid.Column="0" Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                        </Border>

                                        <!-- Equipment Name -->
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" FontSize="14" VerticalAlignment="Center"/>

                                        <!-- Availability Status -->
                                        <Border Grid.Column="2" Background="#EEF2F6" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IsAvailable, StringFormat='Available: {0}'}" 
                                                       FontSize="11" 
                                                       FontWeight="Bold"
                                                       Foreground="#2563EB"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Selected Equipment Details Card -->
            <Border Grid.Column="1" 
                    Background="#F8FAFC" 
                    BorderBrush="#CBD5E1" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="SELECTED EQUIPMENT" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>

                    <TextBlock Text="{Binding SelectedEquipment.Name, FallbackValue='No equipment selected'}" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#0F172A" />

                    <Separator Background="#E2E8F0"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Item Identifier:" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedEquipment.Id, StringFormat='#{0}', FallbackValue='—'}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Current Availability:" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedEquipment.IsAvailable, StringFormat='Available: {0}', FallbackValue='—'}" 
                                   FontWeight="SemiBold"
                                   Foreground="#059669"/>
                    </StackPanel>

                    <Border Background="#E0F2FE" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <TextBlock Text="💡 In Step 5, the borrowing form (selecting a student &amp; due date) will be added right here."
                                   Foreground="#0369A1" 
                                   FontSize="12" 
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>

</UserControl>