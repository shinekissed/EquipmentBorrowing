<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="16">
        <!-- Page Title -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Equipment Catalog &amp; Management" FontSize="24" FontWeight="Bold" Foreground="#1E293B" />
            <TextBlock Text="Browse catalog, borrow items (UC-01 to UC-03), register new equipment (UC-15), and edit descriptive details (UC-16)." Foreground="#64748B" />
        </StackPanel>

        <!-- Main Content Grid -->
        <Grid Grid.Row="1" ColumnDefinitions="3*,3*" ColumnSpacing="16">

            <!-- Equipment List Area -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#E2E8F0" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,0,10">
                        <TextBlock Grid.Column="0" 
                                   Text="EQUIPMENT INVENTORY" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="#64748B" 
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" 
                                Content="Refresh" 
                                Command="{Binding Refresh}" 
                                FontSize="11" 
                                Padding="8,4" 
                                Background="#F1F5F9" 
                                Foreground="#475569" 
                                CornerRadius="4"/>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding EquipmentList}"
                             SelectedItem="{Binding SelectedEquipment}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Equipment">
                                <Border Padding="12,10" Margin="0,3" CornerRadius="6" Background="#F8FAFC">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Identifier Badge -->
                                        <Border Grid.Column="0" Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Identifier}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                        </Border>

                                        <!-- Equipment Name & Description -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14"/>
                                            <TextBlock Text="{Binding Description, FallbackValue='No description'}" 
                                                       FontSize="11" 
                                                       Foreground="#64748B"/>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="2" 
                                                Background="#EEF2F6" 
                                                CornerRadius="4" 
                                                Padding="8,3" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IsAvailable, StringFormat='Available: {0}'}" 
                                                       FontSize="11" 
                                                       FontWeight="Bold"
                                                       Foreground="#2563EB"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Action Area: Tabs for Borrow, Register, and Edit -->
            <Border Grid.Column="1" 
                    Background="#F8FAFC" 
                    BorderBrush="#CBD5E1" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="18">
                <Grid RowDefinitions="Auto,*">

                    <!-- Feedback & Validation Banner -->
                    <Border Grid.Row="0"
                            IsVisible="{Binding HasFeedback}"
                            Background="#F1F5F9"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,14">
                        <TextBlock Text="{Binding FeedbackMessage}"
                                   Foreground="#0F172A"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Operations Tabs -->
                    <TabControl Grid.Row="1">

                        <!-- Tab 1: Borrow Equipment (UC-03) -->
                        <TabItem Header="Borrow Item (UC-03)">
                            <ScrollViewer Margin="0,10,0,0">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="BORROW EQUIPMENT FORM" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>

                                    <!-- Selected Item Info -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Selected Item:" Foreground="#64748B" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedEquipment.Name, FallbackValue='(None selected)'}" 
                                                   FontSize="16" 
                                                   FontWeight="Bold" 
                                                   Foreground="#0F172A" />
                                    </StackPanel>

                                    <Separator Background="#E2E8F0"/>

                                    <!-- Student Selector -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Select Borrower (Student):" FontSize="13" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding Students}"
                                                  SelectedItem="{Binding SelectedStudent}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="domain:Student">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding StudentNumber}" FontWeight="Bold" Foreground="#64748B"/>
                                                        <TextBlock Text="-" Foreground="#94A3B8"/>
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Expected Return Date -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Expected Return Date:" FontSize="13" FontWeight="SemiBold"/>
                                        <CalendarDatePicker SelectedDate="{Binding ExpectedReturnDate}" 
                                                            HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <!-- Submit Button -->
                                    <Button Content="Borrow Equipment"
                                            Command="{Binding BorrowEquipmentCommand}"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="0,12"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Margin="0,8,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: Register Equipment (UC-15) -->
                        <TabItem Header="Register Item (UC-15)">
                            <ScrollViewer Margin="0,10,0,0">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="REGISTER NEW EQUIPMENT (UC-15)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Equipment Identifier *" FontSize="12" Foreground="#475569"/>
                                        <TextBox Text="{Binding NewIdentifier}" PlaceholderText="e.g. EQ-005" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Equipment Name *" FontSize="12" Foreground="#475569"/>
                                        <TextBox Text="{Binding NewName}" PlaceholderText="e.g. Digital Multimeter" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Description / Specifications (Optional)" FontSize="12" Foreground="#475569"/>
                                        <TextBox Text="{Binding NewDescription}" PlaceholderText="e.g. Handheld True-RMS Multimeter" />
                                    </StackPanel>

                                    <Button Content="Register Equipment"
                                            Command="{Binding RegisterEquipmentCommand}"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="0,10"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Margin="0,6,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 3: Update Equipment (UC-16) -->
                        <TabItem Header="Edit Details (UC-16)">
                            <ScrollViewer Margin="0,10,0,0">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="EDIT EQUIPMENT DETAILS (UC-16)" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock Text="Update descriptive fields for the selected item. Availability and borrowing history remain preserved." 
                                               FontSize="11" 
                                               Foreground="#64748B" 
                                               TextWrapping="Wrap"/>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Equipment Identifier *" FontSize="12" Foreground="#475569"/>
                                        <TextBox Text="{Binding EditIdentifier}" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Equipment Name *" FontSize="12" Foreground="#475569"/>
                                        <TextBox Text="{Binding EditName}" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Description (Optional)" FontSize="12" Foreground="#475569"/>
                                        <TextBox Text="{Binding EditDescription}" />
                                    </StackPanel>

                                    <Button Content="Save Equipment Details"
                                            Command="{Binding UpdateEquipmentCommand}"
                                            Background="#0F172A"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="0,10"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Margin="0,6,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Border>

        </Grid>
    </Grid>

</UserControl>
