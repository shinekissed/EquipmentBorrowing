<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

	<Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="16">
		<!-- Header -->
		<StackPanel Grid.Row="0" Spacing="4">
			<TextBlock Text="Active Borrowings &amp; Returns" FontSize="24" FontWeight="Bold" Foreground="#1E293B" />
			<TextBlock Text="Track active equipment borrowings and process item returns." Foreground="#64748B" />
		</StackPanel>

		<!-- Main Content: Left List (3*) + Right Action Details Panel (2*) -->
		<Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="16">

			<!-- Active Borrowings List -->
			<Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
				<Grid RowDefinitions="Auto,*">
					<TextBlock Grid.Row="0"
                               Text="CURRENT ACTIVE BORROWINGS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               Margin="4,0,0,10"/>

					<ListBox Grid.Row="1"
                             ItemsSource="{Binding ActiveBorrowings}"
                             SelectedItem="{Binding SelectedBorrowing}">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:BorrowingItemDisplay">
								<Border Padding="12,10" Margin="0,3" CornerRadius="6" Background="#F8FAFC">
									<Grid ColumnDefinitions="Auto,*,Auto">
										<!-- ID Badge -->
										<Border Grid.Column="0" Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
											<TextBlock Text="{Binding Id, StringFormat='Rec #{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
										</Border>

										<!-- Student and Equipment info -->
										<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
											<TextBlock Text="{Binding EquipmentName}" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A"/>
											<TextBlock Text="{Binding StudentName, StringFormat='Borrowed by: {0}'}" FontSize="12" Foreground="#64748B"/>
										</StackPanel>

										<!-- Status Badge -->
										<Border Grid.Column="2" Background="#FEF3C7" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
											<TextBlock Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#D97706"/>
										</Border>
									</Grid>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</Border>

			<!-- Selected Borrowing Details & Action Card -->
			<Border Grid.Column="1"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
				<StackPanel Spacing="14">
					<TextBlock Text="BORROWING DETAILS &amp; RETURN" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>

					<TextBlock Text="{Binding SelectedBorrowing.EquipmentName, FallbackValue='(No item selected)'}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A" />

					<Separator Background="#E2E8F0"/>

					<StackPanel Spacing="6">
						<TextBlock Text="Borrower:" Foreground="#64748B" FontSize="12"/>
						<TextBlock Text="{Binding SelectedBorrowing.StudentName, FallbackValue='—'}" FontWeight="SemiBold"/>
					</StackPanel>

					<StackPanel Spacing="6">
						<TextBlock Text="Date Borrowed:" Foreground="#64748B" FontSize="12"/>
						<TextBlock Text="{Binding SelectedBorrowing.DateBorrowed, StringFormat='{}{0:MMMM dd, yyyy}', FallbackValue='—'}" FontWeight="SemiBold"/>
					</StackPanel>

					<StackPanel Spacing="6">
						<TextBlock Text="Expected Return Date:" Foreground="#64748B" FontSize="12"/>
						<TextBlock Text="{Binding SelectedBorrowing.DueDate, StringFormat='{}{0:MMMM dd, yyyy}', FallbackValue='—'}" FontWeight="SemiBold" Foreground="#B45309"/>
					</StackPanel>

					<!-- Return Button -->
					<Button Content="Return Equipment"
                            Command="{Binding ReturnEquipmentCommand}"
                            Background="#D97706"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="0,12"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,8,0,0"/>

					<!-- Feedback Banner -->
					<Border IsVisible="{Binding HasFeedback}"
                            Background="#F1F5F9"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,10,0,0">
						<TextBlock Text="{Binding FeedbackMessage}"
                                   Foreground="#0F172A"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
					</Border>
				</StackPanel>
			</Border>

		</Grid>
	</Grid>

</UserControl>