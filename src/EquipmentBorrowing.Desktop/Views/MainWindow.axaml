<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        Width="950" Height="620"
        WindowStartupLocation="CenterScreen"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Campus Equipment Borrowing System">

	<Grid RowDefinitions="Auto,*">
		<!-- Top Application Header -->
		<Border Grid.Row="0" Background="#1E293B" Padding="20,14">
			<StackPanel Orientation="Horizontal" Spacing="10">
				<TextBlock Text="🏫" FontSize="20" VerticalAlignment="Center"/>
				<TextBlock Text="Campus Equipment Borrowing System"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
			</StackPanel>
		</Border>

		<!-- Main Body: Navigation Sidebar (Left) + Content View (Right) -->
		<Grid Grid.Row="1" ColumnDefinitions="220,*">
			<!-- Sidebar Navigation -->
			<Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="14">
				<StackPanel Spacing="10">
					<TextBlock Text="NAVIGATION" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="6,4,0,6"/>

					<Button Content="📦  Equipment"
                            Command="{Binding ShowEquipmentCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10"
                            CornerRadius="6" />

					<Button Content="📋  Active Borrowings"
                            Command="{Binding ShowBorrowingsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10"
                            CornerRadius="6" />
				</StackPanel>
			</Border>

			<!-- Dynamic View Area -->
			<TransitioningContentControl Grid.Column="1"
                                         Content="{Binding CurrentView}"
                                         Margin="12" />
		</Grid>
	</Grid>

</Window>